@model RegistroViewModel
@{
    ViewData["Title"] = "Crear cuenta";
    Layout = "_LayoutAuth";
}
<div style="max-width:460px">
    <h1 class="mb-1">Crea tu cuenta</h1>
    <p class="text-secondary mb-4">Empieza a seguir tu rendimiento académico.</p>

    <form asp-action="Registro" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <div class="mb-3">
            <label asp-for="NombreCompleto" class="form-label small fw-semibold"></label>
            <input asp-for="NombreCompleto" class="form-control" autocomplete="name" />
            <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-sm-7">
                <label asp-for="Carrera" class="form-label small fw-semibold"></label>
                <input asp-for="Carrera" class="form-control" placeholder="Computación y Sistemas" />
            </div>
            <div class="col-sm-5">
                <label asp-for="Ciclo" class="form-label small fw-semibold"></label>
                <select asp-for="Ciclo" asp-items="@(new SelectList(RegistroViewModel.Ciclos))" class="form-select">
                    <option value="">Elige</option>
                </select>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label small fw-semibold"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-sm-6">
                <label asp-for="Password" class="form-label small fw-semibold"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="ConfirmarPassword" class="form-label small fw-semibold"></label>
                <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
            </div>
        </div>
        <button type="submit" class="btn btn-primary w-100 py-2">Crear cuenta</button>
    </form>
    <p class="mt-4 mb-0 small text-center text-secondary">¿Ya tienes cuenta? <a asp-action="Login" class="fw-semibold">Inicia sesión</a></p>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
