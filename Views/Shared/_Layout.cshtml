@inject SignInManager<ApplicationUser> SignInManager
@inject IOptions<PieHostOptions> PieHost
@{
    var tiempoReal = User.IsInRole("Usuario") && PieHost.Value.Configurado;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Plataforma de Cursos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark barra">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Plataforma de Cursos</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                        aria-controls="menu" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav me-auto">
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Resumen</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Usuarios">Usuarios</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Cursos">Cursos</a></li>
                        }
                        else if (User.IsInRole("Usuario"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Usuario" asp-action="Panel">Panel principal</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Usuario" asp-action="MisCursos">Mis cursos</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Usuario" asp-action="Desempeno">Desempeño</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Usuario" asp-action="Donaciones">Donaciones</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-md-center">
                        @if (tiempoReal)
                        {
                            <li class="nav-item me-3">
                                <span id="estado-tiempo-real" class="badge text-bg-secondary" role="status">Conectando…</span>
                            </li>
                        }
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link me-2" asp-controller="Cuenta" asp-action="MiSesion">
                                    @(Context.Session.GetString(SesionKeys.Nombre) ?? User.Identity?.Name)
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Cuenta" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Registro">Crear cuenta</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="alert alert-success" role="status">@mensaje</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }
        @RenderBody()
    </main>

    @if (tiempoReal)
    {
        <div id="tiempo-real" data-url="@PieHost.Value.UrlWebSocket" hidden></div>
        <div id="avisos-tiempo-real" class="avisos" aria-live="polite"></div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (tiempoReal)
    {
        <script src="~/js/tiempo-real.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>