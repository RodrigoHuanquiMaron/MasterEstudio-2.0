@inject SignInManager<ApplicationUser> SignInManager
@inject IOptions<PieHostOptions> PieHost
@{
    var tiempoReal = User.IsInRole("Usuario") && PieHost.Value.Configurado;
    var nombre = Context.Session.GetString(SesionKeys.Nombre) ?? User.Identity?.Name;
    var rol = Context.Session.GetString(SesionKeys.Rol) ?? (User.IsInRole("Administrador") ? "Administrador" : "Estudiante");
}
@functions {
    string Activo(string controller, string action) =>
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), controller, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), action, StringComparison.OrdinalIgnoreCase)
            ? "activo" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MasterEstudio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <nav class="navbar navbar-expand-md py-0">
            <div class="container">
                <a class="marca me-4" asp-controller="Home" asp-action="Index">
                    <span class="marca-logo"><i class="bi bi-mortarboard-fill"></i></span>
                    <span>Master<span class="marca-acento">Estudio</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                        aria-controls="menu" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav nav-principal me-auto">
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item"><a class="nav-link @Activo("Admin", "Index")" asp-controller="Admin" asp-action="Index">Resumen</a></li>
                            <li class="nav-item"><a class="nav-link @Activo("Admin", "Usuarios")" asp-controller="Admin" asp-action="Usuarios">Usuarios</a></li>
                            <li class="nav-item"><a class="nav-link @Activo("Admin", "Cursos")" asp-controller="Admin" asp-action="Cursos">Cursos</a></li>
                            <li class="nav-item"><a class="nav-link @Activo("Admin", "Donaciones")" asp-controller="Admin" asp-action="Donaciones">Donaciones</a></li>
                        }
                        else if (User.IsInRole("Usuario"))
                        {
                            <li class="nav-item"><a class="nav-link @Activo("Usuario", "Panel")" asp-controller="Usuario" asp-action="Panel">Panel</a></li>
                            <li class="nav-item"><a class="nav-link @Activo("Usuario", "MisCursos")" asp-controller="Usuario" asp-action="MisCursos">Mis Cursos</a></li>
                            <li class="nav-item"><a class="nav-link @Activo("Usuario", "Desempeno")" asp-controller="Usuario" asp-action="Desempeno">Desempeño</a></li>
                            <li class="nav-item"><a class="nav-link @Activo("Usuario", "Donaciones")" asp-controller="Usuario" asp-action="Donaciones">Donaciones</a></li>
                            <li class="nav-item"><a class="nav-link @Activo("Usuario", "Estudio")" asp-controller="Usuario" asp-action="Estudio"><i class="bi bi-stopwatch me-1"></i>Estudiar</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-md-center gap-2 py-2 py-md-0">
                        @if (tiempoReal)
                        {
                            <li class="nav-item">
                                <span id="estado-tiempo-real" class="badge text-bg-secondary" role="status">Conectando…</span>
                            </li>
                        }
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="usuario-chip" asp-controller="Cuenta" asp-action="MiSesion" title="Mi sesión">
                                    <span class="text-end d-none d-lg-block">
                                        <span class="nombre d-block">@nombre</span>
                                        <span class="rol">@rol</span>
                                    </span>
                                    <span class="avatar">@Calificacion.Iniciales(nombre)</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Cuenta" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-light-borde btn-sm" title="Cerrar sesión">
                                        <i class="bi bi-box-arrow-right"></i><span class="d-md-none ms-1">Cerrar sesión</span>
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="alert alert-success" role="status">@mensaje</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }
        @RenderBody()
    </main>

    @if (tiempoReal)
    {
        <div id="tiempo-real" data-url="@PieHost.Value.UrlWebSocket" hidden></div>
        <div id="avisos-tiempo-real" class="avisos" aria-live="polite"></div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (tiempoReal)
    {
        <script src="~/js/tiempo-real.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
