@model List<Inscripcion>
@{ ViewData["Title"] = "Mis cursos"; }
<h1 class="h3 mb-4">Mis cursos</h1>

@if (!Model.Any())
{
    <div class="caja text-secondary">Aún no te inscribes en ningún curso. Elige uno en el <a asp-action="Panel">panel principal</a>.</div>
}
else
{
    <div class="caja p-0 table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Curso</th><th>Horas</th><th style="width:30%">Progreso</th><th></th></tr></thead>
            <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td>@i.Curso!.Titulo</td>
                    <td>@i.Curso.Horas</td>
                    <td>
                        <div class="progress" role="progressbar" aria-valuenow="@i.Progreso" aria-valuemin="0" aria-valuemax="100" aria-label="Progreso en @i.Curso.Titulo">
                            <div class="progress-bar" style="width:@i.Progreso%"></div>
                        </div>
                        <span class="small text-secondary">@i.Progreso %</span>
                    </td>
                    <td class="text-end">
                        @if (i.Progreso < 100)
                        {
                            <form asp-action="Avanzar" asp-route-id="@i.Id" method="post">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Registrar avance</button>
                            </form>
                        }
                        else
                        {
                            <span class="badge text-bg-success">Completado</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}