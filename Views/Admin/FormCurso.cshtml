@model Curso
@{
    var accion = ViewData["Accion"] as string ?? "CrearCurso";
    var esEdicion = accion == "EditarCurso";
    ViewData["Title"] = esEdicion ? "Editar curso" : "Agregar curso";
}
<div class="tarjeta" style="max-width:760px">
    <h1 class="h4 fw-bold mb-4">@ViewData["Title"]</h1>
    <form asp-action="@accion" asp-route-id="@(esEdicion ? Model.Id.ToString() : null)" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

        <div class="mb-3">
            <label asp-for="Titulo" class="form-label small fw-semibold"></label>
            <input asp-for="Titulo" class="form-control" />
            <span asp-validation-for="Titulo" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label small fw-semibold"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Instructor" class="form-label small fw-semibold"></label>
                <input asp-for="Instructor" class="form-control" placeholder="Dr. Helen Vance" />
                <span asp-validation-for="Instructor" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Categoria" class="form-label small fw-semibold"></label>
                <select asp-for="Categoria" asp-items="@(new SelectList(Curso.Categorias))" class="form-select">
                    <option value="">Elige una categoría</option>
                </select>
                <span asp-validation-for="Categoria" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="ImagenUrl" class="form-label small fw-semibold"></label>
            <input asp-for="ImagenUrl" class="form-control" placeholder="https://..." />
            <div class="form-text">Opcional. Si la dejas vacía se muestra un fondo según la categoría.</div>
            <span asp-validation-for="ImagenUrl" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <label asp-for="Horas" class="form-label small fw-semibold"></label>
                <input asp-for="Horas" class="form-control" />
                <span asp-validation-for="Horas" class="text-danger small"></span>
            </div>
            <div class="col-6 col-md-3">
                <label asp-for="Creditos" class="form-label small fw-semibold"></label>
                <input asp-for="Creditos" class="form-control" />
                <span asp-validation-for="Creditos" class="text-danger small"></span>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">@(esEdicion ? "Guardar cambios" : "Agregar curso")</button>
        <a asp-action="Cursos" class="btn btn-link">Cancelar</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
