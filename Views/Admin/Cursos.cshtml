@model List<Curso>
@{ ViewData["Title"] = "Cursos"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Cursos</h1>
    <a class="btn btn-primary" asp-action="CrearCurso">Agregar curso</a>
</div>

<div class="caja p-0 table-responsive">
    <table class="table align-middle mb-0">
        <thead><tr><th>Título</th><th>Horas</th><th>Inscritos</th><th>Creado</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>
                    <div class="fw-semibold">@c.Titulo</div>
                    <div class="small text-secondary">@c.Descripcion</div>
                </td>
                <td>@c.Horas</td>
                <td>@c.Inscripciones.Count</td>
                <td>@c.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</td>
                <td class="text-end">
                    <form asp-action="EliminarCurso" asp-route-id="@c.Id" method="post"
                          onsubmit="return confirm('¿Eliminar este curso? También se eliminarán sus inscripciones.');">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>