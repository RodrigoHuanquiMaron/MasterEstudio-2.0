@model PerfilUsuarioViewModel
@{ ViewData["Title"] = "Perfil de " + Model.Usuario.NombreCompleto; }

<a asp-action="Usuarios" class="link-sm"><i class="bi bi-arrow-left"></i> Volver a usuarios</a>
<div class="page-head mt-2">
    <div class="d-flex align-items-center gap-3">
        <span class="avatar" style="width:52px;height:52px;font-size:1rem">@Calificacion.Iniciales(Model.Usuario.NombreCompleto)</span>
        <div>
            <h1>@Model.Usuario.NombreCompleto</h1>
            <p class="page-sub">
                @Model.Usuario.Email · @Model.Rol
                @if (!string.IsNullOrEmpty(Model.Usuario.Carrera)) { <span>· @Model.Usuario.Carrera</span> }
                @if (!string.IsNullOrEmpty(Model.Usuario.Ciclo)) { <span>· @Model.Usuario.Ciclo</span> }
                · registrado el @Model.Usuario.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy")
            </p>
        </div>
    </div>
    <span class="chip-ciclo"><i class="bi bi-clock-history"></i> @Calificacion.Horas(Model.HorasEstudio) de estudio</span>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="tarjeta">
            <h2 class="tarjeta-titulo">Cursos y calificaciones</h2>
            <p class="tarjeta-sub mb-3">Asigna la calificación (0 a 100) de cada curso. Déjala vacía y guarda para quitarla.</p>
            @if (!Model.Inscripciones.Any())
            {
                <p class="text-secondary small mb-0">No está inscrito en ningún curso.</p>
            }
            @foreach (var i in Model.Inscripciones)
            {
                <div class="border-bottom py-3">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                        <div>
                            <div class="fw-semibold">@i.Curso?.Titulo</div>
                            <div class="small text-secondary">@(i.Curso?.Categoria ?? "General") · progreso @i.Progreso%</div>
                        </div>
                        <span class="badge-estado @Calificacion.ClaseEstado(i.Progreso)">@Calificacion.Estado(i.Progreso)</span>
                    </div>
                    <div class="barra mb-2"><span style="width:@(i.Progreso)%"></span></div>
                    <form asp-action="Calificar" method="post" class="d-flex flex-wrap align-items-center gap-2">
                        <input type="hidden" name="inscripcionId" value="@i.Id" />
                        <label for="nota-@i.Id" class="small text-secondary">Calificación</label>
                        <input id="nota-@i.Id" name="nota" type="number" min="0" max="100" step="0.1"
                               value="@(i.Nota?.ToString("0.#"))" class="form-control form-control-sm" style="width:110px" />
                        <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                        <span class="small fw-semibold ms-auto">Actual: @Calificacion.Texto(i.Nota)</span>
                    </form>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="tarjeta">
            <h2 class="tarjeta-titulo">Donaciones</h2>
            <p class="tarjeta-sub mb-2">Total: S/ @Model.TotalDonado.ToString("N2")</p>
            @if (!Model.Donaciones.Any())
            {
                <p class="small text-secondary mb-0">Sin donaciones.</p>
            }
            @foreach (var d in Model.Donaciones)
            {
                <div class="py-2 border-bottom small">
                    <div class="d-flex justify-content-between">
                        <span>@d.Fecha.ToLocalTime().ToString("dd/MM/yyyy") · S/ @d.Monto.ToString("N2")</span>
                        <span class="badge-sent @Calificacion.ClaseSentimiento(d.Sentimiento)">@(d.Sentimiento ?? Sentimientos.SinAnalizar)</span>
                    </div>
                    @if (!string.IsNullOrEmpty(d.Mensaje))
                    {
                        <div class="text-secondary mt-1">"@d.Mensaje"</div>
                    }
                </div>
            }
        </div>
    </div>
</div>
